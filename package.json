{
  "name": "ncse",
  "version": "0.0.0",
  "private": true,
  "description": "ncse 公务员考试练习网站（自用备考平台）",
  "workspaces": [
    "apps/*",
    "packages/*",
    "tools/*"
  ],
  "engines": {
    "node": ">=22.12.0",
    "npm": ">=10.0.0"
  },
  "scripts": {
    "build:shared": "npm run build -w @ncse/shared",
    "check": "npm run build:shared && npm run check --workspaces --if-present",
    "build": "npm run build:shared && npm run build -w @ncse/web",
    "test": "npm run test --workspaces --if-present",
    "lint": "eslint .",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "eslint": "^10.12.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "prettier": "^3.9.9",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.1"
  }
}
